<Window x:Class="FileIndexer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileIndexer — Индексация папок" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Панель управления -->
            <RowDefinition Height="Auto"/>
            <!-- Строка поиска -->
            <RowDefinition Height="*"/>
            <!-- Основная область -->
            <RowDefinition Height="Auto"/>
            <!-- Статус-бар -->
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="AddFolderButton" Content="Добавить папку…" Click="AddFolderButton_Click" Padding="10,5" Margin="0,0,5,0"/>
            <ListBox x:Name="FoldersListBox" Width="300" Height="40" Margin="0,0,5,0"/>
            <Button x:Name="IndexButton" Content="Индексировать" Click="IndexButton_Click" Padding="10,5" Margin="0,0,5,0"/>
            <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" Padding="10,5" Margin="0,0,5,0" IsEnabled="False"/>
            <ProgressBar x:Name="IndexProgressBar" Width="200" Height="20" Margin="0,0,5,0"/>
            <TextBlock x:Name="CurrentPathTextBlock" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <!-- Строка поиска -->
        <WrapPanel Grid.Row="1" Margin="10,0,10,10">
            <TextBox x:Name="SearchTextBox" Width="250" Padding="5" TextChanged="SearchTextBox_TextChanged" ToolTip="Поиск по имени"/>
            <ComboBox x:Name="CategoryComboBox" Width="120" Margin="5,0" SelectedIndex="0">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Image"/>
                <ComboBoxItem Content="Audio"/>
                <ComboBoxItem Content="Video"/>
                <ComboBoxItem Content="Text"/>
                <ComboBoxItem Content="Archive"/>
                <ComboBoxItem Content="Other"/>
            </ComboBox>
            <TextBox x:Name="ExtensionTextBox" Width="80" Padding="5" Margin="0,0,5,0" ToolTip="Расширение (например, .pdf)"/>
            <TextBox x:Name="MinSizeTextBox" Width="100" Padding="5" Margin="0,0,5,0" ToolTip="Мин. размер, байт"/>
            <Button x:Name="SearchButton" Content="Найти" Click="SearchButton_Click" Padding="10,5"/>
        </WrapPanel>

        <!-- Основная область: таблица + превью -->
        <Grid Grid.Row="2" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Таблица результатов -->
            <DataGrid x:Name="ResultsDataGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="ResultsDataGrid_SelectionChanged" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Размер" Binding="{Binding SizeHuman}" Width="100"/>
                    <DataGridTextColumn Header="Изменён" Binding="{Binding Modified, StringFormat='g'}" Width="150"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="Путь" Binding="{Binding FullPath}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Область превью -->
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Margin="10,0,0,0">
                <ScrollViewer x:Name="PreviewScrollViewer" VerticalScrollBarVisibility="Auto">
                    <!-- Содержимое превью будет добавляться программно -->
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Статус-бар -->
        <StatusBar Grid.Row="3" Margin="10">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Готов"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>